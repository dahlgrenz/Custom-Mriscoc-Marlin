# Kopiera denna fil till .env och fyll i dina egna värden.
# .env läses in av flutter_dotenv vid appstart och är listad i .gitignore.

SPOTIFY_CLIENT_ID=din_spotify_client_id
SPOTIFY_REDIRECT_URI=musicquiz://callback

# Valfritt: Firebase Hosting-URL till webbklienten, för att spela på DISTANS
# (inte bara samma Wi-Fi). Lämna tom om du bara vill använda LAN.
# Ex: https://ditt-projekt.web.app  (se firebase.json + README)
HOSTING_URL=
